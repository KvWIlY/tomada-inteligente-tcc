# Copie para backend/.env (nunca commite o real). Segredos vivem SÓ aqui.
# SENHA = a mesma que voce pos no lugar de TROQUE_ESTA_SENHA em scripts/bootstrap-mysql.sql.
DATABASE_URL=mysql://tcc_app:SENHA@127.0.0.1:3306/tcc
# Crie o banco com: mysql -u root -p < scripts/bootstrap-mysql.sql
# Para zerar os dados sem perder o schema:
#   mysql -u tcc_app -p tcc < scripts/limpar-dados.sql
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(36))"
JWT_SECRET=troque-por-32-bytes-aleatorios-de-verdade
BIND_ADDR=0.0.0.0:8080
JWT_TTL_SECS=3600
# Origens do DASHBOARD liberadas no CORS (separadas por virgula, sem barra final).
# So o navegador precisa disto - o firmware nao manda `Origin`. Vazio => usa o
# padrao (http://localhost:5173,http://127.0.0.1:5173, o dev server do Vite).
# Ao servir o `frontend/dist` de outro host da LAN, acrescente-o aqui.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
