# Frontend (feature 004). Sem segredo: o dashboard so fala com o backend proprio,
# autenticado pelo JWT de usuario obtido em POST /auth/login (guardado em localStorage).
# Copie para `.env` e preencha.

# Base URL da API do backend, SEM barra final. Vazio => o dashboard mostra uma tela
# dizendo o que falta configurar e para por ali (nao existe modo MOCK).
VITE_BACKEND_URL=http://localhost:8080

# Opcional: fixa uma residencia especifica em vez de usar a primeira do dono.
VITE_RESIDENCIA_ID=
