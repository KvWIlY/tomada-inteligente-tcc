# Superficie minima de bootstrap (feature 002, Principio VIII / FR-002).
#
# NAO inclua anon key nem TOMADA_ID/RESIDENCIA_ID: a identidade e a auth do
# dispositivo vem do provisionamento em runtime (JWT por-dispositivo no cache de
# credenciais em LittleFS), nunca do binario. O .bin gerado e generico (SC-001/SC-002).
#
# Copie para `firmware/.env` e preencha. O `dotenv!()` le este arquivo em tempo de
# COMPILACAO e embute os valores como &'static str no binario.

# --- Wi-Fi de bootstrap (rede de casa) ---
WIFI_SSID=
WIFI_PASSWORD=

# --- Supabase ---
# URL do projeto, ex.: https://mmsmfvzbcrkoscqnhvky.supabase.co
PROJECT_URL=
# Publishable key PUBLICA (sb_publishable_...). Exigida pelo gateway como header `apikey`.
# E publica por design (RLS default-deny); a auth de dados real e o JWT por-device.
SUPABASE_PUBLISHABLE_KEY=

# --- Provisionamento (bootstrap de 1a vez) ---
# Claim-code de USO UNICO do dashboard. Usado so no 1o boot (sem credencial em LittleFS)
# p/ obter segredo+JWT. Apos provisionar, pode deixar vazio. NAO e segredo de dados.
CLAIM_CODE=
