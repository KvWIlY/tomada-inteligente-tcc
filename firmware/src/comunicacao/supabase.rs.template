// Helpers internos
// ============================================================

/// Extrai um valor i64 de uma chave JSON simples.
/// Busca "chave": seguido de digitos (com opcional "-" no inicio).
fn extrair_i64(body: &str, chave: &str) -> Option<i64> {
    let key = format!("\"{}\":", chave);
    let pos = body.find(&key)? + key.len();
    let resto = body[pos..].trim_start();
    let fim = resto
        .find(|c: char| !c.is_ascii_digit() && c != '-')
        .unwrap_or(resto.len());
    resto[..fim].parse().ok()
}

/// Extrai a substring JSON do objeto "config" aninhado.
/// Busca "config":{ e retorna tudo ate o } correspondente.
fn extrair_json_config(body: &str) -> Option<&str> {
    let marca = "\"config\":";
    let inicio = body.find(marca)? + marca.len();
    let slice = body[inicio..].trim_start();

    // Conta chaves para achar o fechamento correto
    let mut depth = 0i32;
    for (i, c) in slice.char_indices() {
        match c {
            '{' => depth += 1,
            '}' => {
                depth -= 1;
                if depth == 0 {
                    return Some(&slice[..=i]);
                }
            }
            _ => {}
        }
    }
    None
}

/// Escapa minimamente uma string pra ser usada DENTRO de aspas em JSON.
fn escape_json(s: &str) -> String {
    s.replace('\\', "\\\\").replace('"', "\\\"")
}
