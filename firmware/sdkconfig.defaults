# Stack sizes (Rust + Wi-Fi/lwIP precisam bastante stack na main task)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=40960
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Flash 4 MB (ESP32 DevKit v1)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Tabela de particoes customizada (com a particao "storage" para o LittleFS)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="C:/y/firmware/partitions.csv"

# Tick FreeRTOS 1 ms
CONFIG_FREERTOS_HZ=1000

# Servidor HTTP do portal de provisionamento: navegadores de celular mandam headers
# grandes (User-Agent, Accept, Cookie, Upgrade-Insecure-Requests...). O padrao de 512
# bytes estoura e o httpd responde 431 "Request Header Fields Too Large" antes de servir
# a pagina (carrega pra sempre). Aumenta o buffer de header e de URI.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024
